# Maintained HTB/pentest tools which are absent from the official Arch repos.
#
# build/build.sh builds these AUR packages as an unprivileged user and exposes
# the resulting packages to mkarchiso through a temporary local repository.
# Prefer -bin packages where upstream publishes release artifacts; avoid
# duplicate, abandoned and legacy-only tools.

# --- MODERN ENUMERATION / WEB ---
ffuf-bin
feroxbuster-bin
nuclei-bin
# nuclei-templates is deliberately absent: the SSL-scanning proxy corrupts
# its large tarball during compilation and the template set changes weekly
# anyway. Run `nuclei -update-templates` after installation.
subfinder-bin
httpx-bin
naabu
amass
# dirsearch removed: its AUR PKGBUILD is out-of-date and incompatible with
# the current Arch Python (pkg_resources); directory fuzzing is already
# covered by ffuf, feroxbuster and gobuster.
wafw00f
whatweb
arjun
dalfox-bin

# --- ACTIVE DIRECTORY / WINDOWS / PIVOTING ---
enum4linux-ng
# netexec stable, not netexec-git: the git package requires
# python-asyauth>=0.0.25 but the AUR package is frozen at 0.0.21.
netexec
responder
python-ldap3-ad-auth
python-bloodhound-ce
python-certipy-nxc
evil-winrm-py
ligolo-ng
chisel-bin
peass-ng
pspy-bin

# --- WORDLISTS / PROXY / MOBILE / STEGO ---
seclists
wordlists
burpsuite
android-apktool-bin
steghide
