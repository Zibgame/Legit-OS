#!/usr/bin/env bash
# Apply the LEGIT wallpaper without installing or owning a desktop stack.
# If a Hyprland config already exists, only disable its autogenerated warning.
set -euo pipefail

wallpaper=${LEGIT_WALLPAPER:-/usr/share/backgrounds/legit/ocean-balcony.jpeg}

if [[ ! -r "$wallpaper" ]]; then
    echo "ERROR: wallpaper not found: $wallpaper" >&2
    exit 1
fi

for config in \
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"; do
    [[ -f "$config" ]] || continue
    sed -Ei \
        -e 's/^([[:space:]]*)autogenerated[[:space:]]*=[[:space:]]*1([[:space:]]*(#.*)?)$/\1autogenerated = 0\2/' \
        -e 's/^([[:space:]]*hl\.misc\.autogenerated[[:space:]]*=[[:space:]]*)true/\1false/' \
        "$config"
done

if command -v swww >/dev/null 2>&1; then
    if ! swww query >/dev/null 2>&1; then
        swww-daemon >/dev/null 2>&1 &
        sleep 0.2
    fi
    swww img "$wallpaper" --transition-type none
elif command -v hyprctl >/dev/null 2>&1 && command -v hyprpaper >/dev/null 2>&1; then
    hyprctl hyprpaper unload all >/dev/null 2>&1 || true
    hyprctl hyprpaper preload "$wallpaper"
    hyprctl hyprpaper wallpaper ",$wallpaper"
elif command -v swaybg >/dev/null 2>&1; then
    pkill -x swaybg >/dev/null 2>&1 || true
    nohup swaybg -i "$wallpaper" -m fill >/dev/null 2>&1 &
elif command -v gsettings >/dev/null 2>&1; then
    uri="file://$wallpaper"
    gsettings set org.gnome.desktop.background picture-uri "$uri"
    gsettings set org.gnome.desktop.background picture-uri-dark "$uri"
else
    echo "Wallpaper installed at $wallpaper."
    echo "No supported running wallpaper backend was found; apply it from your desktop config." >&2
    exit 2
fi

echo "LEGIT wallpaper applied. Existing shell and desktop dotfiles were preserved."
