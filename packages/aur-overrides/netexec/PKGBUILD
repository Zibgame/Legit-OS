# NetExec 1.5.1 still names Certipy's old Python project. Certipy renamed it
# to certipy-nxc, so patch only that stale metadata before packaging the
# security-fixed upstream release.

pkgname=netexec
pkgver=1.5.1
pkgrel=2
pkgdesc="Swiss army knife for pentesting Windows and Active Directory"
arch=(x86_64)
url="https://github.com/Pennyw0rth/NetExec"
license=(BSD-2-Clause)
replaces=(crackmapexec)
makedepends=(git rust python-pip python-virtualenv)
options=(!strip)
source=("netexec::git+https://github.com/Pennyw0rth/NetExec.git#tag=v${pkgver}")
sha256sums=(SKIP)

prepare() {
    cd netexec
    sed -i 's/certipy-ad @ git+/certipy-nxc @ git+/' pyproject.toml
    grep -q 'certipy-nxc @ git+' pyproject.toml
}

build() {
    cd netexec
    virtualenv venv
    source venv/bin/activate
    pip install pyinstaller .
    pyinstaller netexec.spec
}

package() {
    cd netexec
    install -Dm755 dist/nxc "$pkgdir/usr/bin/nxc"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
