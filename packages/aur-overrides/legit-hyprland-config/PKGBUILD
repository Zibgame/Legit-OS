# Maintained locally by build/build.sh - not published to the AUR.
# Provides the minimal LEGIT OS Hyprland setup: the wallpaper and a
# wallpaper-only Lua configuration (Hyprland >= 0.57 format), installed into
# /etc/skel so every newly created user (including archinstall-created users)
# receives it and never sees the "autogenerated config" banner.
pkgname=legit-hyprland-config
pkgver=2026.11.08
pkgrel=2
pkgdesc="LEGIT OS minimal Hyprland setup (wallpaper + no-banner config)"
arch=(any)
license=(MIT)
depends=(swaybg)

package() {
    install -Dm644 "$srcdir/hyprland.lua" \
        "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "$srcdir/ocean-balcony.jpeg" \
        "$pkgdir/usr/share/backgrounds/legit/ocean-balcony.jpeg"
}
