# Maintained locally by build/build.sh - not published to the AUR.
# Provides the minimal LEGIT OS Hyprland setup: the wallpaper, a
# wallpaper-only Lua configuration (Hyprland >= 0.57 format, no banner) and
# the tty1 auto-start profile, all installed into /etc/skel so every newly
# created user receives them.  There is no display manager: users log in on
# the console and Hyprland starts immediately on tty1; the lock screen is
# their own choice.
pkgname=legit-hyprland-config
pkgver=2026.11.09
pkgrel=1
pkgdesc="LEGIT OS minimal Hyprland setup (wallpaper, no-banner config, tty autostart)"
arch=(any)
license=(MIT)
depends=(swaybg)
source=(hyprland.lua ocean-balcony.jpeg .bash_profile)
sha256sums=(SKIP SKIP SKIP)

package() {
    install -Dm644 "$srcdir/hyprland.lua" \
        "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "$srcdir/ocean-balcony.jpeg" \
        "$pkgdir/usr/share/backgrounds/legit/ocean-balcony.jpeg"
    install -Dm644 "$srcdir/.bash_profile" \
        "$pkgdir/etc/skel/.bash_profile"
}
