# LEGIT OS system packages (live environment)
# One package per line. Lines starting with '#' and blank lines are ignored.
# Concatenated with every packages/*.list by build/build.sh to produce the
# Archiso package set.

# --- LIVE / ISO BASE (mandatory parts of the archiso releng profile) ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
nbd
pv
amd-ucode
intel-ucode

# --- KERNEL / BOOT / FILESYSTEMS (kept from releng, trimmed) ---
grub
efibootmgr
syslinux
btrfs-progs
cryptsetup
dosfstools
e2fsprogs
f2fs-tools
lvm2

# --- INSTALLER ---
arch-install-scripts
archinstall

# --- NETWORK ---
# ca-certificates is required for all HTTPS mirror access from the live
# environment (curl depends on it being present for TLS verification).
ca-certificates
iwd
wpa_supplicant
networkmanager
bluez
bluez-utils
dnsmasq
openssh
curl
wget
rsync
whois
bind
traceroute

# --- CORE UTILITIES ---
sudo
man-db
man-pages
bash-completion
git
vim
nano
less
which
file
tar
unzip
zip
xz
zstd
tmux
htop
bat
ripgrep

# --- EDITOR / TERMINAL COMPATIBILITY ---
# These packages are system-wide Vim plugins. They do not create or modify
# ~/.vimrc; NERDTree remains available and vim-devicons supplies its glyphs.
vim-nerdtree
vim-devicons

# Expanded by build/build.sh to every current package in Arch's official
# nerd-fonts group. No terminal or desktop configuration is imposed.
@nerd-fonts
noto-fonts
noto-fonts-emoji
terminus-font

# --- BROWSER / DOCS ---
firefox
chromium
