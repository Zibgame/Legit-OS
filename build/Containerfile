# LEGIT OS build image
# Arch Linux container with archiso installed, used by the Makefile.
FROM docker.io/library/archlinux:latest AS builder

# The cached base image can temporarily have a CA bundle older than the live
# Arch mirrors. Bootstrap over HTTP (packages are still PGP-verified), refresh
# the trust store, then continue normally.
RUN printf 'Server = http://geo.mirror.pkgbuild.com/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist \
    && pacman --noconfirm -Sy archlinux-keyring ca-certificates ca-certificates-mozilla \
    && update-ca-trust \
    && pacman --noconfirm -Syu archiso base-devel curl git sudo \
    && pacman --noconfirm -Scc
