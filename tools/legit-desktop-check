#!/bin/sh
# LEGIT OS - verify the GNOME/Adwaita desktop integration (read-only).
#
# Run inside the live ISO (or an installed system) to confirm that the
# settings applied by legit-desktop-init are actually in effect.
set -u

mark() {
    if [ "$1" = 0 ]; then printf '  [x] %s\n' "$2"; else printf '  [ ] %s\n' "$2"; fi
}

echo "============================================================"
echo "LEGIT OS - GNOME desktop integration check"
echo "============================================================"

command -v nautilus       >/dev/null 2>&1; mark $? "nautilus (GNOME Files) installed"
command -v gnome-terminal >/dev/null 2>&1; mark $? "gnome-terminal installed"

scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "")
[ "$scheme" = "'prefer-dark'" ]; mark $? "color-scheme = prefer-dark (got: ${scheme:-none})"

layout=$(gsettings get org.gnome.desktop.wm.preferences button-layout 2>/dev/null || echo "")
echo "$layout" | grep -q 'close'; mark $? "window buttons top-right (got: ${layout:-none})"

term=$(gsettings get org.gnome.Terminal.Legacy.Settings theme-variant 2>/dev/null || echo "")
[ "$term" = "'dark'" ]; mark $? "GNOME Terminal dark variant (got: ${term:-none})"

mime=$(xdg-mime query default inode/directory 2>/dev/null || echo "")
[ "$mime" = "org.gnome.Nautilus.desktop" ]; mark $? "default file manager = Nautilus (got: ${mime:-none})"

[ -d /usr/share/icons/Win11-dark ]; mark $? "Win11 icon theme installed"
icontheme=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || echo "")
[ "$icontheme" = "'Win11-dark'" ]; mark $? "icon theme = Win11-dark (got: ${icontheme:-none})"
[ "${QT_QPA_PLATFORMTHEME:-}" = "gtk3" ]; mark $? "QT_QPA_PLATFORMTHEME=gtk3 (bar uses Win11 icons)"

for f in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    [ -f "$f" ] && grep -q 'prefer-dark-theme=1' "$f"; mark $? "GTK dark fallback: $f"
done

[ -d "$HOME/.config/quickshell/legit-shell" ]; mark $? "LEGIT Shell config present"
[ -f "$HOME/.config/hypr/hyprland.lua" ];      mark $? "Hyprland Lua config present"

echo
echo "Window shortcuts: Super / Super+Space, Super+E (Nautilus), Super+R,"
echo "Ctrl+Alt+T (GNOME Terminal), Alt+F4, Alt+Tab, Super+Arrows."
echo "If a line is unchecked, run 'legit-desktop-init' then log out and back in."
