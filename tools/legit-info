#!/usr/bin/env bash
# legit-info - quick environment baseline for LEGIT OS.
set -euo pipefail

echo "============================================================"
echo "LEGIT OS - Trust me, it's legit."
echo "============================================================"
echo
echo "Kernel    : $(uname -r)"
echo "Arch      : $(uname -m)"
echo "Uptime    : $(uptime -p 2>/dev/null || echo unknown)"
echo "Session   : ${XDG_SESSION_TYPE:-tty}${WAYLAND_DISPLAY:+ ($WAYLAND_DISPLAY)}"
echo
echo "Offensive tooling available:"
for tool in nmap sqlmap nikto hydra john hashcat aircrack-ng \
            ghidra radare2 gdb metasploit binwalk bettercap; do
    command -v "$tool" >/dev/null 2>&1 \
        && printf '  [x] %s -> %s\n' "$tool" "$(command -v "$tool")" \
        || printf '  [ ] %s\n' "$tool"
done
echo
echo "Installer : legit-install  (Archinstall + LEGIT preset)"
echo "Docs      : Installation_guide"
